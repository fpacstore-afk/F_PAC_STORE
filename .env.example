# ==============================================================================
# F PAC STORE — CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Domínio Oficial: https://fpacstore.com.br
# ==============================================================================
# ATENÇÃO: Nunca insira valores reais ou segredos neste arquivo de exemplo.
# Em produção, todas as credenciais sensíveis devem ser injetadas exclusivamente
# através do Google Cloud Secret Manager no serviço Cloud Run.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VARIÁVEIS PÚBLICAS (Injetadas no Bundle do Frontend via Vite)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExamplePublicApiKeyForClientApp123
VITE_FIREBASE_AUTH_DOMAIN=fpac-store62.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fpac-store62
VITE_FIREBASE_STORAGE_BUCKET=fpac-store62.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef0123456789abcdef
VITE_FIREBASE_DATABASE_ID=ai-studio-a7d50f8c-9b01-4490-9a13-dd8892e0c41a
VITE_MERCADO_PAGO_PUBLIC_KEY=APP_USR-00000000-0000-0000-0000-000000000000
VITE_CLOUDINARY_CLOUD_NAME=fpac-store-cloud
VITE_CLOUDINARY_UPLOAD_PRESET=fpac_store_public_preset

# ------------------------------------------------------------------------------
# 2. CONFIGURAÇÕES DO SERVIDOR (Variáveis de Ambiente do Cloud Run)
# ------------------------------------------------------------------------------
NODE_ENV=production
FIREBASE_PROJECT_ID=fpac-store62
FIREBASE_DATABASE_ID=ai-studio-a7d50f8c-9b01-4490-9a13-dd8892e0c41a
ALLOWED_ORIGINS=https://fpacstore.com.br,https://www.fpacstore.com.br
ORIGIN_CEP=89234-100
