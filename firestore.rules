rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------
    // PILLAR 3: Path Variable Hardening & Global Primitives
    // ------------------------------------------------------------
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // PILLAR 6: PII Isolation & Roles
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email == 'fpacstore@gmail.com' || 
              request.auth.token.email == 'atendimento@fpacstore.com.br'); 
    }

    // ------------------------------------------------------------
    // PILLAR 2: Validation Blueprints (Orders & Reviews)
    // ------------------------------------------------------------
    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'customerEmail', 'items', 'total', 'status']) &&
             data.customerName is string && data.customerName.size() <= 200 &&
             data.customerEmail is string && data.customerEmail.size() <= 200 &&
             data.total is number && data.total >= 0 &&
             data.status in ['payment_pending', 'payment_approved', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.items is list && data.items.size() <= 60;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'name', 'rating', 'comment', 'verified', 'createdAt']) &&
             data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.verified is bool &&
             (!('styleInfo' in data) || data.styleInfo == null || (data.styleInfo is string && data.styleInfo.size() <= 100)) &&
             (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128));
    }

    match /orders/{orderId} {
      // PILLAR 3: ID Hardening
      allow get: if isValidId(orderId);
      
      // PILLAR 8: Secure List Queries
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid || 
          resource.data.customerEmail == request.auth.token.email
        )
      );
      
      // PILLAR 2 & 9: Create & Update
      // Allow administrators to create orders directly (e.g., manual orders)
      allow create: if isAdmin(); 
      
      // PILLAR 4: Tiered Identity Logic (Update)
      allow update: if isAdmin() || (
        // Allow customer to cancel their own order during pending states
        existing().status in ['payment_pending', 'received'] &&
        incoming().status == 'cancelled' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
        (existing().userId == request.auth.uid || 
         existing().customerEmail == request.auth.token.email ||
         (!isSignedIn() && true)) // guests can also cancel their order if they have the ID
      );

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /estampas/{estampaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_promotion_products/{relId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /financial_investments/{id} {
      allow read, write: if isAdmin();
    }

    match /financial_cashflow/{id} {
      allow read, write: if isAdmin();
    }

    match /financial_traffic/{id} {
      allow read, write: if isAdmin();
    }

    match /promotion_analytics/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /_health/{docId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isAdmin() || 
                             (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid) || 
                             (!('userId' in resource.data) || resource.data.userId == null);
    }

    // Interaction Collections
    match /interactions/{id} {
       allow create: if isSignedIn() && incoming().userId == request.auth.uid;
       allow read, update, delete: if isAdmin();
    }
  }
}
