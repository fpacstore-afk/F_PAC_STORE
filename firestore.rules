rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Bloqueio global por padrão
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers de autenticação e admin
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email == 'fpacstore@gmail.com' && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Coleção de Pedidos (Orders)
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.customerName is string && data.customerName.size() <= 200 &&
               data.customerPhone is string && data.customerPhone.size() <= 50 &&
               data.address is string && data.address.size() <= 500 &&
               data.total is number && data.total >= 0 &&
               data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'validated'] &&
               data.createdAt is timestamp;
      }

      // Qualquer cliente pode criar um pedido
      allow create: if isValidId(orderId) && isValidOrder(incoming());

      // Link público para o cliente acompanhar seu pedido (apenas leitura de documento único)
      allow get: if true;

      // Permite listar pedidos se for admin ou se os pedidos pertencerem ao usuário (por userId ou CPF)
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.userId == request.auth.uid || 
          (resource.data.cpf != null && resource.data.cpf == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cpf)
        )
      );
      
      // Apenas admin pode atualizar status ou deletar
      allow update: if isAdmin() && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );

      allow delete: if isAdmin();
    }

    // Coleção de Usuários (Perfis) - Cada um só acessa o seu
    match /users/{userId} {
      function isValidProfile(data) {
        return data.name is string && data.name.size() <= 200 &&
               (data.email == null || data.email is string) &&
               (data.phone == null || data.phone is string) &&
               (data.cpf == null || data.cpf is string) &&
               (data.address == null || data.address is string) &&
               (data.number == null || data.number is string) &&
               (data.neighborhood == null || data.neighborhood is string) &&
               (data.city == null || data.city is string) &&
               (data.state == null || data.state is string) &&
               (data.cep == null || data.cep is string);
      }
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidProfile(incoming());
    }

    // Coleção de Produtos
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
