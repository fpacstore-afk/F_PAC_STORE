rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ------------------------------------------------------------
    // PILLAR 3: Path Variable Hardening & Global Primitives
    // ------------------------------------------------------------
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // PILLAR 6: PII Isolation & Roles
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email == 'fpacstore@gmail.com' || 
              request.auth.token.email == 'atendimento@fpacstore.com.br'); 
    }

    // ------------------------------------------------------------
    // PILLAR 2: Validation Blueprints (Orders & Reviews)
    // ------------------------------------------------------------
    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'customerEmail', 'items', 'total', 'productionStatus', 'paymentStatus', 'amountPaid', 'balanceDue']) &&
             data.customerName is string && data.total is number && data.amountPaid is number && data.balanceDue is number &&
             data.productionStatus in ['waiting', 'separacao_corte', 'estamparia', 'costura', 'embalagem', 'ready', 'completed'] &&
             data.paymentStatus in ['pending', 'processing', 'approved', 'rejected', 'cancelled', 'refunded', 'partially_paid', 'partially_refunded'] &&
             (!('shippingStatus' in data) || data.shippingStatus in ['pending', 'label_created', 'shipped', 'in_transit', 'delivered', 'returned']) &&
             data.items is list && data.items.size() <= 60;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['productId', 'name', 'rating', 'comment', 'verified', 'createdAt']) &&
             data.productId is string && data.productId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000 &&
             data.verified is bool &&
             (!('styleInfo' in data) || data.styleInfo == null || (data.styleInfo is string && data.styleInfo.size() <= 100)) &&
             (!('id' in data) || data.id == null || (data.id is string && data.id.size() <= 128));
    }

    match /orders/{orderId} {
      // PILLAR 3: ID Hardening & Access Control
      allow get: if isValidId(orderId) && (
        isAdmin() || (
          isSignedIn() && (
            ('userId' in resource.data && resource.data.userId != null && resource.data.userId != '')
              ? resource.data.userId == request.auth.uid
              : (request.auth.token.email_verified == true && resource.data.customerEmail == request.auth.token.email)
          )
        )
      );
      
      // PILLAR 8: Secure List Queries
      allow list: if isAdmin() || (
        isSignedIn() && (
          ('userId' in resource.data && resource.data.userId != null && resource.data.userId != '')
            ? resource.data.userId == request.auth.uid
            : (request.auth.token.email_verified == true && resource.data.customerEmail == request.auth.token.email)
        )
      );
      
      // PILLAR 2 & 9: Create
      allow create: if isAdmin() || (isSignedIn() && isValidOrder(incoming()));
      
      // PILLAR 4: Tiered Identity Logic (Update)
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      allow list: if isAdmin();

      // A signed-in customer may manage only their own non-privileged profile data.
      // Administrative authorization fields are server/admin controlled and can
      // never be created, changed or removed by the profile owner.
      allow create: if (isSignedIn() && request.auth.uid == userId &&
                        !request.resource.data.keys().hasAny(['role', 'isAdmin']));
      allow update: if (isSignedIn() && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'isAdmin']));
      allow delete: if (isSignedIn() && request.auth.uid == userId) || isAdmin();

      // Trusted admins retain profile-management access.
      allow create, update: if isAdmin();
    }

    match /inventory/{itemId} {
      // Operational inventory contains internal quantities and is not public.
      // Customer-facing availability must be exposed through a minimal/public
      // projection or trusted backend endpoint, never through raw inventory docs.
      allow read, write: if isAdmin();
    }

    match /estampas/{estampaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /designs/{designId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /weekly_promotion_products/{relId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /history_cards/{cardId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /music/{musicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read, write: if isAdmin();
    }

    match /stock_movements/{movementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /stock_reservations/{reservationId} {
      allow read, write: if isAdmin();
    }

    match /financial_investments/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financial_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financial_cashflow/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financial_traffic/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /financial_payables/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /suppliers/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // FASE 9.6.4 — Governança Comercial & Metas (Admin read-only no client, mutações exclusivas backend)
    match /commercial_actions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_action_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_goals/{goalId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // FASE 9.6.5 — Planejamento Comercial & Forecasts (Admin read-only no client, mutações exclusivas backend)
    match /commercial_forecasts/{forecastId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_forecast_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // FASE 9.6.6 — Orçamento Comercial & Guardrails (Admin read-only no client, mutações exclusivas backend)
    match /commercial_budgets/{budgetId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_budget_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // FASE 9.6.7 — Execução Comercial, Plano de Ação & Controle de Resultados (Admin read-only no client, mutações exclusivas backend)
    match /commercial_execution_cycles/{cycleId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_execution_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_action_recommendation_locks/{lockId} {
      allow read, create, update, delete: if false;
    }

    // FASE 9.6.8 — Pós-Mortem Comercial, Eficácia de Ações e Aprendizado Contínuo (Admin read-only no client, mutações exclusivas backend)
    match /commercial_execution_reviews/{reviewId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_execution_review_actions/{actionId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_execution_review_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /commercial_review_cycle_locks/{lockId} {
      allow read, create, update, delete: if false;
    }

    match /commercial_review_insight_locks/{lockId} {
      allow read, create, update, delete: if false;
    }

    match /idempotency_records/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /promotion_analytics/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /_health/{docId} {
      // Health diagnostics must not be writable by anonymous clients.
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isAdmin() || 
                             (isSignedIn() && 'userId' in resource.data && resource.data.userId == request.auth.uid);
    }

    // Interaction Collections
    match /interactions/{id} {
       allow create: if isSignedIn() && incoming().userId == request.auth.uid;
       allow read, update, delete: if isAdmin();
    }

    // Analytics Visitor Tracking Sessions
    match /visitor_sessions/{sessionId} {
       allow create, update: if isValidId(sessionId);
       allow read, list, delete: if isAdmin();
    }

    // Identity Quiz Sessions
    match /identity_quiz_sessions/{sessionId} {
       allow create, update: if isValidId(sessionId);
       allow read, list, delete: if isAdmin();
    }

  }
}
