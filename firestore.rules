rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny - Everything is locked by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- SHARED HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isEmailVerified() && request.auth.token.email == 'fpacstore@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- COLLECTION RULES ---

    // 1. ORDERS COLLECTION
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.keys().hasAll(['customerName', 'customerPhone', 'address', 'total', 'status', 'createdAt']) &&
               data.customerName is string && data.customerName.size() <= 200 &&
               data.customerPhone is string && data.customerPhone.size() <= 50 &&
               data.address is string && data.address.size() <= 500 &&
               data.total is number && data.total >= 0 &&
               data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'validated', 'approved'] &&
               data.createdAt == request.time;
      }

      // Create: Anyone can create if valid (Guest or Auth)
      allow create: if isValidId(orderId) && isValidOrder(incoming());

      // Get: Only owner, admin or guest with ID (ID poisoning guard)
      allow get: if isValidId(orderId) && (
                 isAdmin() || 
                 (isSignedIn() && resource.data.userId == request.auth.uid) ||
                 (!isSignedIn() && true)); // ID entropy is our protection for guests

      // List: Strictly restricted to Admin or Auth User's own orders
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Update: Admin can change status (Action Based + Terminal State Locking)
      allow update: if isValidId(orderId) && isAdmin() && 
                    existing().status != 'delivered' && 
                    existing().status != 'cancelled' &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                    incoming().status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled', 'validated', 'approved'] &&
                    incoming().updatedAt == request.time;

      allow delete: if isValidId(orderId) && isAdmin();
    }

    // 2. USERS COLLECTION (Profiles)
    match /users/{userId} {
      function isValidProfile(data) {
        return data.keys().hasAll(['name', 'email']) &&
               data.name is string && data.name.size() <= 200 &&
               data.email == request.auth.token.email &&
               (data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
               (data.cpf == null || (data.cpf is string && data.cpf.size() <= 20)) &&
               (data.address == null || (data.address is string && data.address.size() <= 500)) &&
               (data.number == null || (data.number is string && data.number.size() <= 50)) &&
               (data.neighborhood == null || (data.neighborhood is string && data.neighborhood.size() <= 200)) &&
               (data.city == null || (data.city is string && data.city.size() <= 200)) &&
               (data.state == null || (data.state is string && data.state.size() <= 2)) &&
               (data.cep == null || (data.cep is string && data.cep.size() <= 20));
      }

      allow read: if isSignedIn() && request.auth.uid == userId;
      
      // Allow write (create/update) only for own profile
      allow write: if isSignedIn() && request.auth.uid == userId && isValidProfile(incoming());
    }

    // 3. INVENTORY COLLECTION
    match /inventory/{itemId} {
      allow read: if true;
      
      // Stock Updates: Allowed via Admin OR during Checkout (Master Gate Relational Invariant)
      // Note: Checkout.tsx uses transaction to update stock. 
      // For maximum security, we'd verify the stock decrement is correct, but Firestore rules limitations 
      // on math in existing vs incoming make this complex. 
      // We allow admin for full control and check for minimal changes for checkout.
      allow update: if isAdmin() || (
        // Checkout specific update: can only change stock and updatedAt
        incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'available', 'updatedAt']) &&
        incoming().updatedAt == request.time
      );
      
      allow create, delete: if isAdmin();
    }

    // 4. ESTAMPAS & PRODUCTS
    match /estampas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
