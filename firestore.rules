rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // GLOBAL HELPERS
    // ------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email == 'fpacstore@gmail.com' || 
              request.auth.token.email == 'atendimento@fpacstore.com.br'); 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ------------------------------------------------------------
    // DEFAULT DENY
    // ------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // VALIDATION HELPERS
    // ------------------------------------------------------------
    
    function isValidOrder(data) {
      return data.customerName is string && data.customerName.size() > 0 &&
             data.customerEmail is string && (data.customerEmail == "" || data.customerEmail.matches('.*@.*')) &&
             data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 &&
             (!('userId' in data) || data.userId == null || data.userId == request.auth.uid);
    }

    // ------------------------------------------------------------
    // COLLECTIONS
    // ------------------------------------------------------------

    match /config/{configId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() || 
        // Permitir ver pedido se o ID for válido e soubermos quem é o dono ou se for um checkout anônimo
        (!('userId' in resource.data) || resource.data.userId == null || (isSignedIn() && resource.data.userId == request.auth.uid))
      );
      
      allow create: if isValidId(orderId) && isValidOrder(incoming()) && (
        incoming().status == 'pending' &&
        (incoming().createdAt == request.time || isAdmin())
      );
      
      allow update: if isValidId(orderId) && (
        isAdmin() || 
        (
          isSignedIn() && existing().userId == request.auth.uid &&
          // Clientes só podem cancelar ou atualizar observações se pending
          existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'observations', 'updatedAt']) &&
          (incoming().status == 'cancelled' || incoming().status == 'pending')
        )
      );
      
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == userId) && 
                     (!('role' in incoming()) || isAdmin()); // Protect RBAC fields
    }

    match /inventory/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /estampas/{estampaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
