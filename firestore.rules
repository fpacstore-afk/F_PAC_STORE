rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Primitives
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Hardened isAdmin: Initially more permissive with email for debugging, 
    // but typically should require isEmailVerified()
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email == 'fpacstore@gmail.com' || 
              request.auth.token.email == 'atendimento@fpacstore.com.br'); 
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Config Collection
    match /config/{configId} {
      allow get, list: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      // Aberto para testes de checkout e diagnóstico do servidor
      allow get, create, update: if true;
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow list: if isAdmin();
      allow write: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
    }

    // Inventory Collection
    match /inventory/{itemId} {
      allow read: if true;
      allow update: if isAdmin() || (
        // Permitir atualização de estoque durante checkout
        incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'available', 'variants', 'updatedAt'])
      );
      allow create, delete: if isAdmin();
    }

    // Estampas Collection
    match /estampas/{estampaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
