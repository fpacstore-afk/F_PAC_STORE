rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (request.auth.token.email == 'fpacstore@gmail.com' || request.auth.token.email == 'atendimento@fpacstore.com.br');
    }
    // Only management lists the bucket or writes directly.
    match /{allPaths=**} { allow read, write: if isAdmin(); }
    // Only catalog media and the legacy radio folder are public downloads.
    // Every other object remains private unless an admin is signed in.
    match /{folder}/{allPaths=**} {
      allow get: if folder == 'catalog-media' || folder == 'Musicas do Site';
    }
  }
}
