{
  "entities": {
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Availability status for various items in the store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["product", "print", "color", "size"] },
        "available": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "available"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Customer personal and shipping information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "cpf": { "type": "string" },
        "address": { "type": "string" },
        "number": { "type": "string" },
        "complement": { "type": "string" },
        "neighborhood": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "cep": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Estampa": {
      "title": "Estampa",
      "description": "Design prints available for products",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "allowedLocations": { "type": "array", "items": { "type": "string" } },
        "locationConfigs": { 
          "type": "object",
          "description": "Configuration for each location including manual sizes"
        },
        "slotIndex": { "type": "number" },
        "available": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "image"]
    },
    "Product": {
      "title": "Product",
      "description": "Store product with variants and details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "headline": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stampGallery": { "type": "array", "items": { "type": "string" } },
        "sizes": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array", "items": { "type": "object" } },
        "specs": { "type": "array", "items": { "type": "string" } },
        "isNew": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "stock": { "type": "number", "default": 0 },
        "minStock": { "type": "number", "default": 5 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "price", "images"]
    },
    "Review": {
      "title": "Product Review",
      "description": "Customer feedback and ratings for products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "styleInfo": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "name", "rating", "comment", "verified"]
    },
    "WeeklyPromotion": {
      "title": "Weekly Promotion",
      "description": "Weekly automatic or manual discount campagn configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "banner_image": { "type": "string" },
        "active": { "type": "boolean" },
        "discount_type": { "type": "string", "enum": ["percentage", "fixed_amount", "free_shipping", "combo", "progressive"] },
        "discount_value": { "type": "number" },
        "start_date": { "type": "string", "format": "date-time" },
        "end_date": { "type": "string", "format": "date-time" },
        "colors": { "type": "array", "items": { "type": "string" } },
        "countdown_enabled": { "type": "boolean" },
        "product_ids": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "discount_type", "discount_value", "active"]
    },
    "WeeklyPromotionProduct": {
      "title": "Weekly Promotion Product Relation",
      "description": "Association between weekly promotion and a specific product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "promotion_id": { "type": "string" },
        "product_id": { "type": "string" },
        "discount_value_override": { "type": "number" },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["promotion_id", "product_id"]
    },
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "Brand and identity visual configuration",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "heroUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "aboutUrl": { "type": "string" },
        "communityUrls": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with items and payment status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "validated", "approved", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "paymentId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AppSettings": {
      "title": "Application Settings",
      "description": "Application configuration settings documents like Google Sheets integration webhook URL",
      "type": "object",
      "properties": {
        "webhookUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "FinancialInvestment": {
      "title": "Financial Investment",
      "description": "Initial custom investment details such as printers and startup costs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["description", "amount", "category", "date"]
    },
    "FinancialCashFlow": {
      "title": "Financial Cash Flow",
      "description": "Store operational income and outcome entries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["in", "out"] },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["description", "amount", "type", "category", "date"]
    },
    "FinancialTraffic": {
      "title": "Financial Traffic",
      "description": "Advertising campaign spends and traffic statistics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "campaignName": { "type": "string" },
        "amountSpent": { "type": "number" },
        "date": { "type": "string" },
        "clicks": { "type": "number" },
        "conversions": { "type": "number" }
      },
      "required": ["campaignName", "amountSpent", "date"]
    },
    "StockMovement": {
      "title": "Stock Movement",
      "description": "Historical log of stock changes from QR Code scanning or manual adjustment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productSlug": { "type": "string" },
        "productName": { "type": "string" },
        "variantKey": { "type": "string" },
        "quantity": { "type": "number" },
        "type": { "type": "string", "enum": ["Produção", "Venda Local", "Ajuste"] },
        "operator": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "variantKey", "quantity", "type", "createdAt"]
    },
    "VisitorSession": {
      "title": "Visitor Session",
      "description": "Detailed real-time tracking session of an anonymous or identified visitor",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string" },
        "visitorId": { "type": "string" },
        "isNewUser": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastActive": { "type": "number" },
        "pagesVisited": { "type": "number" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "device": { "type": "string", "enum": ["desktop", "mobile", "tablet"] },
        "browser": { "type": "string" },
        "os": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string" },
        "referrer": { "type": "string" },
        "utm_source": { "type": "string" },
        "utm_medium": { "type": "string" },
        "utm_campaign": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "isIdentified": { "type": "boolean" },
        "cartStarted": { "type": "boolean" },
        "checkoutStarted": { "type": "boolean" },
        "purchaseCompleted": { "type": "boolean" },
        "totalSpent": { "type": "number" },
        "searches": { "type": "array", "items": { "type": "string" } },
        "viewedProducts": { "type": "array", "items": { "type": "string" } },
        "cartProducts": { "type": "array", "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "object" } }
      },
      "required": ["sessionId", "visitorId", "lastActive", "pagesVisited"]
    }
  },
  "firestore": {
    "/visitor_sessions/{sessionId}": {
      "schema": "VisitorSession",
      "description": "Real-time analytics and behavioral tracking for active/inactive visitors"
    },
    "/settings/{docId}": {
      "schema": "AppSettings",
      "description": "Application settings documents like integrations details"
    },
    "/financial_investments/{id}": {
      "schema": "FinancialInvestment",
      "description": "Initial financial investments catalog"
    },
    "/financial_cashflow/{id}": {
      "schema": "FinancialCashFlow",
      "description": "Operating cash flow ledger"
    },
    "/financial_traffic/{id}": {
      "schema": "FinancialTraffic",
      "description": "Traffic campaign spends ledger"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders catalog"
    },
    "/config/{configId}": {
      "schema": "SiteConfig",
      "description": "Global application configuration documents"
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Store availability for products, prints, colors, and sizes"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Registered customer profiles"
    },
    "/estampas/{estampaId}": {
      "schema": "Estampa",
      "description": "Available prints catalog"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Products in the store catalog"
    },
    "/weekly_promotions/{promoId}": {
      "schema": "WeeklyPromotion",
      "description": "Weekly promotions definitions"
    },
    "/weekly_promotion_products/{relId}": {
      "schema": "WeeklyPromotionProduct",
      "description": "Association mapping between promotions and products"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product and store customer reviews and testimonials"
    },
    "/stock_movements/{movementId}": {
      "schema": "StockMovement",
      "description": "Historical logs of inventory actions including QR scans for production or sales"
    }
  }
}
