{
  "hosting": {
    "site": "fpac-store62",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.map",
      "server.cjs"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "f-pac-store-n-o-s-roupa-identidade",
          "region": "us-east1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "trailingSlash": false,
    "cleanUrls": true
  },
  "firestore": [
    {
      "database": "ai-studio-a7d50f8c-9b01-4490-9a13-dd8892e0c41a",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": false
    }
  }
}
